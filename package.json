{
  "name": "chatprism-workspace",
  "private": true,
  "description": "ChatPrism is a multi-host AI workspace for model comparison, history recovery, and knowledge-centric conversation workflows.",
  "repository": {
    "type": "git",
    "url": "https://github.com/quanzhou/JARVIS.git"
  },
  "homepage": "https://github.com/quanzhou/JARVIS#readme",
  "bugs": {
    "url": "https://github.com/quanzhou/JARVIS/issues"
  },
  "scripts": {
    "dev:server": "pnpm --filter server dev",
    "dev:web": "pnpm --filter web2 dev",
    "dev:desktop:renderer": "pnpm --filter desktop2 dev:renderer",
    "dev:desktop:host": "pnpm --filter desktop2 dev:host",
    "typecheck": "pnpm --filter server typecheck && pnpm --filter web2 typecheck && pnpm --filter desktop2 exec vue-tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "pnpm run typecheck",
    "build:server": "pnpm --filter server build",
    "build:web": "pnpm --filter web2 build",
    "build:desktop": "pnpm --filter desktop2 build",
    "diagram:core": "pnpm exec tsuml2 --glob \"./packages/core/src/**/!(*.d|*.test|*.spec).ts\" --outMermaidDsl \"./docs/architecture/core-class-diagram.mmd\" --outFile \"./docs/architecture/core-class-diagram.svg\" --memberAssociations --exportedTypesOnly",
    "test:server": "pnpm --filter server test",
    "test:core": "pnpm --filter @packages/core test",
    "test:ui": "pnpm --filter @packages/ui test",
    "test:web": "pnpm --filter web2 test",
    "test:desktop": "pnpm --filter desktop2 test",
    "test:e2e:web": "pnpm --filter web2 test:e2e",
    "test:e2e:desktop": "pnpm --filter desktop2 test:e2e"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.15.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron"
    ],
    "ignoredBuiltDependencies": [
      "esbuild",
      "spawn-sync"
    ]
  },
  "devDependencies": {
    "tsuml2": "^0.17.1",
    "typescript": "^5.9.3"
  }
}
