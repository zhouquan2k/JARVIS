    "build:probe:dom:electron": "../../apps/desktop2/node_modules/.bin/esbuild scripts/domChatProbeElectron.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/scripts/dom-chat-probe-electron.mjs --external:electron --alias:@packages/core=../../packages/core --alias:@packages/ui=../../packages/ui",
    "probe:dom:electron": "pnpm build:probe:dom:electron && ../../apps/desktop2/node_modules/.bin/electron dist/scripts/dom-chat-probe-electron.mjs --"
  },
  "dependencies": {
    "@packages/core": "workspace:*",
