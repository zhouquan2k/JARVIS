{
  "name": "web2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:icons": "node scripts/build-web2-icons.mjs",
    "dev": "vite",
    "build": "pnpm build:icons && vite build",
    "build:e2e": "VITE_E2E=1 VITE_SYNC_KEY=web2-e2e VITE_CONTEXT_BASE_URL=http://127.0.0.1:8791/api/context VITE_SYNC_BASE_URL=http://127.0.0.1:8791/api/sync pnpm build",
    "typecheck": "vue-tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:pwa": "pnpm build:e2e && WEB2_E2E_USE_RENDERER_DIST=1 playwright test tests/e2e/pwa-offline.spec.ts --project chromium"
  },
  "dependencies": {
    "@packages/core": "workspace:*",
    "@packages/ui": "workspace:*",
    "pinia": "^3.0.4",
    "vue": "^3.5.29",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.8.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^2.1.8",
    "vue-tsc": "^3.2.5"
  }
}
