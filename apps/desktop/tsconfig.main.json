{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "paths": {
      "@packages/core": ["../../packages/core"],
      "@packages/core/*": ["../../packages/core/*"],
      "@packages/ui": ["../../packages/ui"],
      "@packages/ui/*": ["../../packages/ui/*"]
    },
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,
    "outDir": "dist/main",
    "rootDir": "."
  },
  "include": ["main/**/*.ts", "shared/**/*.ts"],
  "exclude": ["main/**/*.test.ts"]
}
