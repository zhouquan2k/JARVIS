{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "@packages/core": ["../../packages/core/src/index.ts"],
      "@packages/core/*": ["../../packages/core/*"],
      "@packages/core/src": ["../../packages/core/src/index.ts"],
      "@packages/core/config": ["../../packages/core/config.ts"]
    },
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts"
  ]
}
