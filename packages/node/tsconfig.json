{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@packages/core": ["../core/index.ts"],
      "@packages/core/*": ["../core/*"]
    },
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts"
  ]
}
