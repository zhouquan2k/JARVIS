{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@packages/core": ["../core/index.ts"],
      "@packages/core/*": ["../core/*"],
      "@plugins/task-mgr": ["../../plugins/task-mgr/src/index.ts"],
      "@plugins/task-mgr/*": ["../../plugins/task-mgr/*"],
      "@plugins/task-mgr/api": ["../../plugins/task-mgr/api.ts"]
    },
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts"
  ]
}
